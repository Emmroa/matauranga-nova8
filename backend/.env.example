# ============================================================
# MĀTAURANGA NOVA v2 — Environment Variables Template
# Copy: cp .env.example .env  — then fill in your values
# NEVER commit .env to git
# ============================================================

# ── SERVER ───────────────────────────────────────────────────
PORT=10000
ALLOWED_ORIGINS=http://YOUR_SERVER_IP,http://localhost

# ── SESSION ──────────────────────────────────────────────────
SESSION_SECRET=change-me-use-32-random-bytes
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── ADMIN DASHBOARD ──────────────────────────────────────────
ADMIN_USERNAME=your-admin-username
DASHBOARD_PASSWORD=change-me-use-strong-password
# generate: openssl rand -base64 24

# ── OLLAMA (LOCAL AI — zero cloud) ───────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=45
OLLAMA_KEEP_ALIVE=2h

# ── TIMEOUTS (ms) ────────────────────────────────────────────
# Defaults shown — override only if on slower/faster hardware
QUEUE_TIMEOUT_MS=180000
HANDSHAKE_TIMEOUT_MS=180000
STREAM_HARD_TIMEOUT_MS=180000
