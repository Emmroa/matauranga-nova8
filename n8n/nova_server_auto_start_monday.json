      "name": "PM2 Start NOVA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "jsCode": "\nconst { execSync } = require('child_process');\nconst result = execSync('/usr/bin/pm2 start nova-backend').toString();\nconst fs = require('fs');\nfs.mkdirSync('/home/ubuntu/logs', { recursive: true });\nfs.appendFileSync('/home/ubuntu/logs/pm2_schedule.log',\n  '[' + new Date().toISOString() + '] START nova-backend\\n' + result + '\\n');\nreturn [{ json: { action: 'start', ts: new Date().toISOString() } }];\n"
      }
    }
