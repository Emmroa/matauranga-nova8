    {
      "id": "sd-stop",
      "name": "PM2 Stop NOVA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "jsCode": "\nconst { execSync } = require('child_process');\nconst result = execSync('/usr/bin/pm2 stop nova-backend').toString();\nconst fs = require('fs');\nfs.mkdirSync('/home/ubuntu/logs', { recursive: true });\nfs.appendFileSync('/home/ubuntu/logs/pm2_schedule.log',\n  '[' + new Date().toISOString() + '] STOP nova-backend\\n' + result + '\\n');\nreturn [{ json: { action: 'stop', ts: new Date().toISOString() } }];\n"
      }
    }
  ],
