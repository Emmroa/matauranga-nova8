      "id": "cr-log",
      "name": "Log Crisis Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "jsCode": "\nconst fs = require('fs');\nconst now = new Date().toISOString();\nconst body = ($input.first().json.body) || {};\nconst region = body.region || 'unknown';\nconst topic  = body.topic  || 'unknown';\nconst lang   = body.lang   || 'unknown';\nconst line = '[' + now + '] CRISIS_EVENT region=' + region + ' topic=' + topic + ' lang=' + lang + '\\n';\nconst dir = '/home/ubuntu/logs';\nfs.mkdirSync(dir, { recursive: true });\nfs.appendFileSync(dir + '/crisis_log.txt', line);\nreturn [{ json: { logged: true, ts: now } }];\n"
      }
    }
  ],
